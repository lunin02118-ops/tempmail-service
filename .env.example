APP_ENV=prod
APP_BASE_URL=https://example.com
PUBLIC_MAIL_DOMAIN=mail.example.com
DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
DATABASE_URL_DIRECT=postgresql+psycopg://user:pass@host/dbname
SESSION_SECRET=change-me
INGEST_WEBHOOK_SECRET=change-me
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

GROQ_API_KEYS=
# Alternative Groq key format if you do not want one CSV variable:
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Optional automation keys
NEON_API_KEY=
RENDER_API_KEY=

# Optional R2 variables if raw MIME or attachments are stored outside the app DB
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Legacy bridge settings, keep only while Gmail-based migration code still exists
GMAIL_CLIENT_SECRET_PATH=./google_client_secret.json
GMAIL_TOKEN_PATH=./google_token.json
GMAIL_POLL_SECONDS=60
DEFAULT_FROM_ALIAS_DOMAIN=example.com
TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO
